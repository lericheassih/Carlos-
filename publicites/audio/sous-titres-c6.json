[
 {
  "start": 0.3,
  "end": 2.05,
  "text": "Comment réserver sur le site LUMO ?"
 },
 {
  "start": 2.2,
  "end": 3.25,
  "text": "Suivez le guide."
 },
 {
  "start": 3.8,
  "end": 6.9,
  "text": "Un : ouvrez le site, touchez « Découvrir les appartements »."
 },
 {
  "start": 7.8,
  "end": 10.5,
  "text": "Deux : choisissez vos dates, les voyageurs et le quartier."
 },
 {
  "start": 11.3,
  "end": 12.54,
  "text": "Puis touchez « Rechercher »."
 },
 {
  "start": 13.2,
  "end": 14.49,
  "text": "Trois : comparez les logements."
 },
 {
  "start": 15.4,
  "end": 16.83,
  "text": "Le cœur garde vos favoris."
 },
 {
  "start": 17.8,
  "end": 20.44,
  "text": "Quatre : ouvrez la fiche et faites la visite photo."
 },
 {
  "start": 20.9,
  "end": 22.22,
  "text": "Touchez une photo pour zoomer."
 },
 {
  "start": 23.6,
  "end": 26.32,
  "text": "Cinq : lisez les équipements et la section « À savoir »."
 },
 {
  "start": 28.0,
  "end": 29.52,
  "text": "Six : sélectionnez vos dates."
 },
 {
  "start": 30.0,
  "end": 31.71,
  "text": "Le prix total s'affiche aussitôt."
 },
 {
  "start": 32.8,
  "end": 36.14,
  "text": "Sept : réservez sur WhatsApp, ou envoyez une demande."
 },
 {
  "start": 36.5,
  "end": 39.06,
  "text": "Demande envoyée : on vous recontacte très vite."
 },
 {
  "start": 39.6,
  "end": 41.84,
  "text": "Votre appartement meublé à Lomé vous attend."
 },
 {
  "start": 42.4,
  "end": 43.59,
  "text": "Réservez dès maintenant."
 }
]